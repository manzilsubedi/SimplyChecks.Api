# nginx reverse proxy: receives public traffic for the subdomain and
# forwards it to the API running on localhost:5000. certbot will edit
# this file later to add the HTTPS (443) server block and a redirect.
server {
    listen 80;
    server_name simplychecks.msubedi.com.np;

    # Inspection photos can be a few MB each; the default 1M limit would
    # reject them with "413 Request Entity Too Large".
    client_max_body_size 25M;

    location / {
        proxy_pass http://localhost:5000;
        proxy_http_version 1.1;
        # Pass the real client info through to the app.
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
